# Configuration of notification-service (environment variables; values below are for running it locally)
SERVICE_NAME=notification-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://notification_svc:notification_pass@localhost:5432/shophub
DEFAULT_CHANNEL=email
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
