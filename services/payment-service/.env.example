# Configuration of payment-service (environment variables; values below are for running it locally)
SERVICE_NAME=payment-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://payment_svc:payment_pass@localhost:5432/shophub
MAX_PAYMENT_AMOUNT=5000
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
