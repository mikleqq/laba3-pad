# Configuration of user-service (environment variables; values below are for running it locally)
SERVICE_NAME=user-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://user_svc:user_pass@localhost:5432/shophub
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
