# Configuration of product-service (environment variables; values below are for running it locally)
SERVICE_NAME=product-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://product_svc:product_pass@localhost:5432/shophub
SEED_DEMO_DATA=true
LOW_STOCK_THRESHOLD=3
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
